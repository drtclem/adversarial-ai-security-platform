# ─────────────────────────────────────────────────────────────────────────────
# Adversarial AI Security Platform — environment configuration
# Copy this file to `.env` and fill in the blanks. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode & cost controls (see CLAUDE.md §0 — top priority) ──────────────────────
# local-only : every agent (incl. Judge + Documentation) runs on the local model.
#              ZERO paid API calls. This is the default. Use it for ALL dev/testing.
# live       : Judge -> cheap frontier, Documentation -> frontier. Red Team +
#              Orchestrator stay local. Only use for real runs / the demo.
PLATFORM_MODE=local-only

# Hard per-run budget cap in USD. The LLM router stops the run gracefully when hit.
# Keep this small. Only relevant in `live` mode.
MAX_RUN_USD=0.50

# Default campaign size (attacks per run). Keep small; large runs are opt-in.
DEFAULT_CAMPAIGN_SIZE=8

# ── Target under test (the Week 1/2 Clinical Co-Pilot) ─────────────────────────
# We only send HTTP to this host and read responses. Never modify the target.
TARGET_BASE_URL=http://localhost:8420
TARGET_USERNAME=            # test login (e.g. test_clinician or a dedicated test user) — Taylor provides
TARGET_PASSWORD=            # never commit a real value

# ── Local model (Red Team + Orchestrator, and everything in local-only) ────────
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=               # set in Phase 1 (e.g. an abliterated ~30B instruct tag)

# ── Frontier API (ONLY used in `live` mode: Judge + Documentation) ─────────────
ANTHROPIC_API_KEY=         # only needed for `live`; use a spend-limited key
JUDGE_MODEL=               # cheap frontier for the Judge (e.g. a Haiku-class model)
JUDGE_ESCALATION_MODEL=    # optional: larger model for low-confidence verdicts (off by default)
DOC_MODEL=                 # frontier for Documentation (low volume)

# ── Target version (operator-stamped at deploy) ────────────────────────────────
# Set this to the Co-Pilot's deployed version (e.g. its git commit) when you deploy.
# A value the platform hasn't seen runs the full regression suite before attacking.
TARGET_VERSION=

# ── Calibrated-classifier tier (Laya) — SHADOW MODE, off by default ────────────
# JUDGE_SHADOW=laya records Laya's opinion next to each LLM-tier verdict; it never
# changes a verdict. Needs `pip install -r requirements-laya.txt` + a one-time
# ~850 MB weight download (Hugging Face cache). Local only, $0, PHI stays on-box.
JUDGE_SHADOW=
LAYA_MODEL=convaiinnovations/laya
LAYA_DEVICE=               # blank = auto (mps on Apple Silicon)
LAYA_CALIBRATION=          # optional temperature JSON; only after >=300 human labels
LAYA_ACCEPT_HI=0.9
LAYA_ACCEPT_LO=0.1

# ── Observability (optional; leave blank in local-only) ────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ── Storage (defaults are fine) ────────────────────────────────────────────────
EXPLOIT_DB_PATH=./platform_data/exploits.db
EVENT_STORE_PATH=./platform_data/events.db
